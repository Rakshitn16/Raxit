# Free key from https://build.nvidia.com — no credit card, ~40 requests/minute.
NVIDIA_API_KEY=nvapi-...

# Any OpenAI-compatible endpoint works: Groq, OpenRouter, Together, local vLLM.
RAXIT_BASE_URL=https://integrate.api.nvidia.com/v1

# Verified to handle multi-round tool calling. Alternatives on the same
# endpoint: meta/llama-3.3-70b-instruct (faster, no reasoning),
# moonshotai/kimi-k2.6, z-ai/glm-5.2, nvidia/nemotron-3-ultra-550b-a55b.
# Run `python -m raxit.models` to list everything available.
RAXIT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Nemotron's separate reasoning pass. Measured ~10.3s on vs ~4.1s off for the
# same one-tool question. Off by default for snappy voice replies; routines
# that plan several steps set `thinking: true` in their own YAML.
RAXIT_THINKING=false
RAXIT_REASONING_BUDGET=4096

RAXIT_TEMPERATURE=0.6
RAXIT_TOP_P=0.95
RAXIT_MAX_TOKENS=4096

# Who Raxit is talking to, and where it lives.
RAXIT_OWNER_NAME=Rakshit
RAXIT_TIMEZONE=Asia/Kolkata

# 127.0.0.1 keeps the server on-device. 0.0.0.0 exposes full device control to
# your LAN and there is no auth — only on a network you trust.
RAXIT_HOST=127.0.0.1
RAXIT_PORT=8788

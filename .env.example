# Free key from https://build.nvidia.com — no credit card, ~40 requests/minute.
NVIDIA_API_KEY=nvapi-...

# Any OpenAI-compatible endpoint works: Groq, OpenRouter, Together, local vLLM.
RAXIT_BASE_URL=https://integrate.api.nvidia.com/v1

# Picked for tool-calling reliability. nvidia/nemotron-3.5-lightning-30b-a3b
# is ~0.4s faster per tool round but stops calling tools a few turns into a
# conversation and invents device state instead — see the README table.
# Run `python -m raxit.models` to list all 102 models on the endpoint.
RAXIT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Nemotron's separate reasoning pass. Measured: a two-tool question takes
# ~3.4s with this off and ~12.4s with it on, for the
# same tool choices and a comparable answer. Off by default so voice replies
# stay snappy; routines that plan several steps set `thinking: true` in their
# own YAML.
RAXIT_THINKING=false
RAXIT_REASONING_BUDGET=4096

# How hard to retry a 429, split by whether anyone is waiting. Interactive
# turns fail fast and say to try again; routines wait it out.
RAXIT_MAX_RETRIES=5
RAXIT_MAX_RETRIES_INTERACTIVE=2

RAXIT_TEMPERATURE=0.6
RAXIT_TOP_P=0.95
RAXIT_MAX_TOKENS=4096

# Who Raxit is talking to, and where it lives.
RAXIT_OWNER_NAME=Rakshit
RAXIT_TIMEZONE=Asia/Kolkata

# 127.0.0.1 keeps the server on-device. 0.0.0.0 exposes full device control to
# your LAN and there is no auth — only on a network you trust.
RAXIT_HOST=127.0.0.1
RAXIT_PORT=8788

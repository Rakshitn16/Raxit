# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Who Raxit is talking to, and where it lives.
RAXIT_OWNER_NAME=Rakshit
RAXIT_TIMEZONE=Asia/Kolkata

# claude-opus-5 is the default. claude-sonnet-5 is cheaper and still strong
# for routine device chores; drop to it if the bill matters more than depth.
RAXIT_MODEL=claude-opus-5

# low | medium | high | xhigh | max. `medium` keeps voice replies snappy;
# individual routines can raise it per run.
RAXIT_EFFORT=medium

# 127.0.0.1 keeps the server on-device. Set 0.0.0.0 to reach it from your
# laptop — there is no auth, so only do that on a network you trust.
RAXIT_HOST=127.0.0.1
RAXIT_PORT=8788
